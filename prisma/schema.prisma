generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"] // Ativa o suporte aos schemas auth, app e roster
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "app", "roster"]
}

// ==========================================
// SCHEMA: auth
// ==========================================

model User {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email             String    @unique
  password_hash     String
  user_level        Int       @default(2) // 0: Admin, 1: Sub-Admin, 2: User
  is_active         Boolean   @default(true)
  is_email_verified Boolean   @default(false)
  created_at        DateTime  @default(now()) @db.Timestamptz(3)
  admin_id          String?
  ministry_access   String?   @default("all")
  must_change_password Boolean @default(true)

  profile           UserProfile? // Relação 1:1 com o perfil
  schedules         Schedule[]   // Escalas que este usuário criou

  @@map("users")
  @@schema("auth")
}

// ==========================================
// SCHEMA: app
// ==========================================

model Ministry {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  
  // Relacionamentos que você já tem:
  members     Member[]
  schedules   Schedule[]
  
  // 👇 ADICIONE ESTA LINHA AQUI 👇
  teams       Team[]

  @@map("ministries")
  @@schema("app")
}

model UserProfile {
  user_id    String    @id @db.Uuid
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  full_name  String?   @db.VarChar(255)
  phone      String?   @db.VarChar(20)
  birth_date DateTime? @db.Date
  avatar_url String?
  updated_at DateTime? @default(now()) @db.Timestamptz(3)

  @@map("user_profiles")
  @@schema("app")
}

model Member {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  role        String?  @db.VarChar(100) 
  
  // Substitua o 'team String?' por isso:
  team_id     String?  @db.Uuid
  team        Team?    @relation(fields: [team_id], references: [id], onDelete: SetNull)
  
  ministry_id Int?
  ministry    Ministry? @relation(fields: [ministry_id], references: [id], onDelete: SetNull)
  created_at  DateTime? @default(now()) @db.Timestamptz(3)
  
  shifts      ShiftAssignment[]

  @@map("members")
  @@schema("app")
}

model Team {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @db.VarChar(100)
  ministry_id Int?
  ministry    Ministry? @relation(fields: [ministry_id], references: [id], onDelete: Cascade)
  
  members     Member[]

  @@map("teams")
  @@schema("app")
}

model SiteAnalytics {
  id        String   @id @default(uuid())
  action    String   // Ex: "VISIT", "WHATSAPP_CLICK", "INSTAGRAM_CLICK"
  page      String?  // Ex: "Home", "Contactos"
  createdAt DateTime @default(now())

  @@map("site_analytics")
  @@schema("app") 
}

// ==========================================
// MÓDULO: CMS (LANDING PAGE) - SCHEMA: app
// ==========================================

model SiteAbout {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title        String    @default("Sobre a Igreja Batista Novo Horizonte") @db.VarChar(255)
  content      String    @db.Text
  image_url    String?
  hero_image_url String?
  stat_members String?   @default("600+") @db.VarChar(50)
  stat_years   String?   @default("52+") @db.VarChar(50)
  stat_cells   String?   @default("25") @db.VarChar(50)
  updated_at   DateTime? @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("site_about")
  @@schema("app")
}

model SiteProgram {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String    @db.VarChar(255)
  day         String    @db.VarChar(50)
  time        String    @db.VarChar(20)
  description String    @db.Text
  image_url   String?
  is_active   Boolean   @default(true)
  order       Int       @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz(3)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("site_programs")
  @@schema("app")
}

model SitePastor {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @db.VarChar(255)
  role        String    @db.VarChar(255)
  bio         String    @db.Text
  image_url   String?
  social_link String?
  is_active   Boolean   @default(true)
  order       Int       @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz(3)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("site_pastors")
  @@schema("app")
}

model SiteMinistry {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @db.VarChar(255)
  description String    @db.Text
  image_url   String?
  tags        String[] @default([])
  is_active   Boolean   @default(true)
  order       Int       @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz(3)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("site_ministries")
  @@schema("app")
}

model SiteCell {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String    @db.VarChar(255)
  leader       String    @db.VarChar(255)
  day          String    @db.VarChar(50)
  time         String    @db.VarChar(20)
  location     String    @db.VarChar(255  )
  audience     String?   @db.VarChar(100)
  contact_link String?   @db.Text
  is_active    Boolean   @default(true)
  order        Int       @default(0)
  created_at   DateTime? @default(now()) @db.Timestamptz(3)
  updated_at   DateTime? @default(now()) @updatedAt @db.Timestamptz(3)
  image_url    String?

  @@map("site_cells")
  @@schema("app")
}

model SiteProject {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String    @db.VarChar(255)
  description String    @db.Text
  image_url   String?
  responsible String?
  tags        String[] @default([])
  is_active   Boolean   @default(true)
  order       Int       @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz(3)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("site_projects")
  @@schema("app")
}

model SiteContact {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  address        String?   @db.Text
  phone_1_name   String?   @default("Josimar") @db.VarChar(100)
  phone_1_number String?   @db.VarChar(50)
  phone_2_name   String?   @default("Diogenes") @db.VarChar(100)
  phone_2_number String?   @db.VarChar(50)
  email          String?   @db.VarChar(255)
  facebook_link  String?   @db.Text
  instagram_link String?   @db.Text
  youtube_link   String?   @db.Text
  service_hours  String?   @db.Text
  updated_at     DateTime? @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("site_contacts")
  @@schema("app")
}

model SiteEvent {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String    @db.VarChar(255)
  description String    @db.Text
  event_date  DateTime  @db.Timestamptz(3) // 👈 Guarda a data real do evento
  end_date    DateTime? @db.Timestamptz(3)
  button_text String?   @default("Saber Mais") @db.VarChar(50)
  link_url    String?   @db.Text
  image_url   String?
  is_active   Boolean   @default(true)
  order       Int       @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz(3)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("site_events")
  @@schema("app")
}

// ==========================================
// SCHEMA: roster
// ==========================================

model Schedule {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  month_reference String    @db.VarChar(7)
  ministry_id     Int?
  ministry        Ministry? @relation(fields: [ministry_id], references: [id], onDelete: Cascade)
  author_id       String?   @db.Uuid
  author          User?     @relation(fields: [author_id], references: [id])
  created_at      DateTime? @default(now()) @db.Timestamptz(3)
  
  shifts          Shift[]

  @@map("schedules")
  @@schema("roster")
}

model Shift {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  schedule_id String?   @db.Uuid
  schedule    Schedule? @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  shift_date  DateTime  @db.Date
  day_name    String?   @db.VarChar(20)
  
  members     ShiftAssignment[]

  @@map("shifts")
  @@schema("roster")
}

model ShiftAssignment {
  shift_id  String @db.Uuid
  shift     Shift  @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  member_id String @db.Uuid
  member    Member @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@id([shift_id, member_id])
  @@map("shift_assignments")
  @@schema("roster")
}

model SiteConstructionInfo {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pix_key       String?   @db.VarChar(255) // Aqui vai o CNPJ ou a chave PIX
  qr_code_url   String?   @db.Text         // A imagem do QR Code gerado pelo banco
  instagram_url String?   @db.Text         // O link do "Saiba Mais" para o Instagram
  
  // 👇 AQUI ESTÁ O NOSSO SWITCH 👇
  is_active     Boolean   @default(false)  // Controla se a seção aparece no site ou não
  description   String?   @db.Text // Para o texto: "A Igreja Batista está a crescer..."
  verse_text    String?   @db.Text
  
  updated_at    DateTime? @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("site_construction_info")
  @@schema("app")
}

// 2. Tabela para as fotos da obra (Carrossel)
model SiteConstructionPhoto {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  image_url  String    @db.Text
  order      Int       @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(3)

  @@map("site_construction_photos")
  @@schema("app")
}

// ==========================================
// FINANCEIRO (DÍZIMOS E OFERTAS)
// ==========================================

model FinancialEntry {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type           String    @db.VarChar(50)  // "DIZIMO" ou "OFERTA"
  value          Decimal   @db.Decimal(10, 2) 
  entry_date     DateTime  @db.Date           // Data real do culto/entrega
  payment_method String    @db.VarChar(50)  // "PIX", "DINHEIRO", "CARTAO", "TRANSFERENCIA"
  member_name    String?   @db.VarChar(255) // Opcional
  
  created_at     DateTime? @default(now()) @db.Timestamptz(3) // Quando foi digitado no sistema
  updated_at     DateTime? @updatedAt @db.Timestamptz(3)      // Se alguém editar para corrigir um erro, muda aqui

  @@map("financial_entries")
  @@schema("app")
}

model FinancialExpense {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  description    String    @db.VarChar(255) // Ex: "Pagamento conta de luz"
  value          Decimal   @db.Decimal(10, 2)
  category       String    @db.VarChar(100) // Ex: "UTILIDADES", "MISSOES", "MANUTENCAO"
  expense_date   DateTime  @db.Date
  payment_method String    @db.VarChar(50)
  
  created_at     DateTime? @default(now()) @db.Timestamptz(3)
  updated_at     DateTime? @updatedAt @db.Timestamptz(3)

  @@map("financial_expenses")
  @@schema("app")
}

model ExpenseCategory {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String    @unique @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamptz(3)

  @@map("expense_categories")
  @@schema("app")
}

model CommunityBusiness {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  full_name         String   @db.VarChar(255) // Nome completo do responsável
  business_name     String   @db.VarChar(255) // Nome do empreendimento
  categories        CommunityBusinessCategory[]
  
  professional_type String   @db.VarChar(50)  // Autônomo, Prestador de serviço, Empresário(a), Outro
  phone             String   @db.VarChar(20)  // Telefone / WhatsApp
  business_model    String   @db.VarChar(50)  // Físico, Online, Ambos
  address           String?  @db.Text         // Endereço (opcional, pois pode ser só online)
  instagram         String?  @db.VarChar(100) // @ do Instagram (opcional)
  description       String   @db.Text         // Descrição breve do negócio
  products_services String   @db.Text         // Produtos ou serviços que oferece
  logo_url          String?  @db.Text         // URL da foto ou logo
  whatsapp_clicks   Int @default(0)
  instagram_clicks  Int @default(0)
  
  // Controles do Painel Admin
  is_active         Boolean  @default(false)  // Começa como 'false' para o painel aprovar antes de ir pro ar
  created_at        DateTime? @default(now()) @db.Timestamptz(3)
  updated_at        DateTime? @updatedAt      @db.Timestamptz(3)

  @@map("community_businesses")
  @@schema("app")
}

model CommunityBusinessCategory {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  is_active   Boolean  @default(true) // Categorias já nascem ativas por padrão
  created_at  DateTime? @default(now()) @db.Timestamptz(3)
  updated_at  DateTime? @updatedAt      @db.Timestamptz(3)

  // Relacionamento: Uma categoria pode ter vários negócios
  businesses  CommunityBusiness[]

  @@map("community_categories")
  @@schema("app")
}

model LandingPageConfig {
  id                 String   @id @default(uuid())
  
  // Configurações do Guia de Empreendedores
  business_form_url  String?  @db.Text
  show_business_form Boolean  @default(true)
  show_whatsapp      Boolean  @default(true)
  whatsapp_number    String?  @default("5573999999999")

  updated_at         DateTime @updatedAt
  
  @@map("landing_page_configs")
  @@schema("app")
}

// ==========================================
// MÓDULO: ENCONTRO COM DEUS (ECD)
// ==========================================

model EcdLeader {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name               String   @db.VarChar(255)
  
  total_yellow_slots Int      @default(0)
  used_yellow_slots  Int      @default(0) 
  total_green_slots  Int      @default(0)
  used_green_slots   Int      @default(0) 
  
  is_active          Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  tokens             EcdToken[]
  registrations      EcdRegistration[]

  @@map("ecd_leaders")
  @@schema("app")
}

model EcdToken {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token_code   String   @unique @default(dbgenerated("uuid_generate_v4()")) @db.Uuid 
  token_type   String   @db.VarChar(50) // "AMARELA" ou "VERDE"
  is_used      Boolean  @default(false)
  usedAt       DateTime? @db.Timestamptz(3)

  leader_id    String   @db.Uuid
  leader       EcdLeader @relation(fields: [leader_id], references: [id], onDelete: Cascade)
  
  registration EcdRegistration?

  @@map("ecd_tokens")
  @@schema("app")
}

model EcdEdition {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique 
  yellow_slots  Int      @default(0)
  green_slots   Int      @default(0)
  worker_slots  Int      @default(0)
  is_active     Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(3)
  public_token String?  @unique @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  worker_leaders       EcdWorkerLeader[]

  registrations EcdRegistration[] 
  worker_slots_config EcdEditionWorkerSlot[]
  worker_registrations EcdWorkerRegistration[]

  @@map("ecd_editions")
  @@schema("app") // Corrigido para "app"
}

model EcdRegistration {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  
  profile_photo_url String?  @db.Text
  receipt_photo_url String?  @db.Text
  
  full_name         String   @db.VarChar(255)
  nickname          String?  @db.VarChar(100)
  phone             String   @db.VarChar(20)
  gender            String   @db.VarChar(1) 
  age               Int
  address           String?  @db.Text
  
  is_married        Boolean  @default(false)
  spouse_name       String?  @db.VarChar(255)
  relative_going    Boolean  @default(false)
  relative_degree   String?  @db.VarChar(100)
  
  has_illness       Boolean  @default(false)
  illness_desc      String?  @db.Text
  takes_medication  Boolean  @default(false)
  medication_desc   String?  @db.Text
  dietary_restriction Boolean @default(false)
  dietary_desc      String?  @db.Text
  shirt_size        String?  @db.VarChar(10)
  
  emergency_contact String?  @db.VarChar(255)
  emergency_phone   String?  @db.VarChar(20)

  in_cell           Boolean  @default(false)
  cell_leader_name  String?  @db.VarChar(255)
  invited_by        String?  @db.VarChar(255)
  
  payment_status    String   @default("PENDENTE") @db.VarChar(50)
  ficha_type        String   @db.VarChar(50) 
  
  leader_id         String   @db.Uuid
  leader            EcdLeader @relation(fields: [leader_id], references: [id])
  
  token_id          String   @unique @db.Uuid
  token             EcdToken @relation(fields: [token_id], references: [id])

  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  
  // Controle de Histórico
  status            String   @default("ATIVO") 
  edition_id        String?  @db.Uuid
  edition           EcdEdition? @relation(fields: [edition_id], references: [id])

  @@map("ecd_registrations")
  @@schema("app")
}

// ==========================================
// MÓDULO: ECD - EQUIPE / TRABALHADORES
// ==========================================

// 1. Áreas de Trabalho (Ex: Cozinha, Apoio, Mídia)
model EcdWorkerArea {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String   @unique @db.VarChar(100)
  
  leaders       EcdWorkerLeader[]
  registrations EcdWorkerRegistration[]
  edition_slots EcdEditionWorkerSlot[]

  @@map("ecd_worker_areas")
  @@schema("app")
}

// 2. Líderes de Equipe (Ex: Pr. Marcos da Cozinha)
model EcdWorkerLeader {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String   @db.VarChar(255)
  
  area_id       String   @db.Uuid
  area          EcdWorkerArea @relation(fields: [area_id], references: [id], onDelete: Cascade)
  slots         Int      @default(0)
  
  edition_id    String   @db.Uuid
  edition       EcdEdition @relation(fields: [edition_id], references: [id], onDelete: Cascade)

  tokens        EcdWorkerToken[]
  registrations EcdWorkerRegistration[]

  @@map("ecd_worker_leaders")
  @@schema("app")
}

// 3. Vagas por Área em cada Edição (Para a aba de Definir Vagas)
model EcdEditionWorkerSlot {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slots       Int      @default(0)
  
  edition_id  String   @db.Uuid
  edition     EcdEdition @relation(fields: [edition_id], references: [id], onDelete: Cascade)
  
  area_id     String   @db.Uuid
  area        EcdWorkerArea @relation(fields: [area_id], references: [id], onDelete: Cascade)

  @@unique([edition_id, area_id]) // Garante que não repete a mesma área na mesma edição
  @@map("ecd_edition_worker_slots")
  @@schema("app")
}

// 4. Links de Inscrição dos Trabalhadores
model EcdWorkerToken {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token_code   String   @unique @default(dbgenerated("uuid_generate_v4()")) @db.Uuid 
  is_used      Boolean  @default(false)
  usedAt       DateTime? @db.Timestamptz(3)

  leader_id    String   @db.Uuid
  leader       EcdWorkerLeader @relation(fields: [leader_id], references: [id], onDelete: Cascade)
  
  registration EcdWorkerRegistration?

  @@map("ecd_worker_tokens")
  @@schema("app")
}

// 5. A Ficha de Pré-inscrição do Trabalhador
model EcdWorkerRegistration {
  id                      String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  
  // --- DADOS DA FICHA ---
  full_name               String   @db.VarChar(255)
  gender                  String   @db.VarChar(1)
  phone                   String   @db.VarChar(20)
  age                     Int
  marital_status          String   @db.VarChar(50)
  
  has_served_before       Boolean  @default(false)
  previous_team           String?  @db.VarChar(100)
  
  bringing_target         Boolean  @default(false)
  target_name             String?  @db.VarChar(255)
  
  cell_leader             String?  @db.VarChar(255)
  
  relative_participating  Boolean  @default(false)
  relative_kinship        String?  @db.VarChar(100)

  // --- SAÚDE E SEGURANÇA ---
  emergency_contact       String?  @db.VarChar(255)
  emergency_phone         String?  @db.VarChar(20)
  health_issues           String?  @db.Text
  dietary_restrictions    String?  @db.Text
  profile_photo_url       String?  @db.Text
  observations            String?  @db.Text

  // --- FLUXO DE PRÉ-INSCRIÇÃO E CONFIRMAÇÃO ---
  status                  String   @default("PENDENTE") @db.VarChar(20) // PENDENTE, APROVADO, RECUSADO
  payment_status          String   @default("PENDENTE") @db.VarChar(20) // PENDENTE, PAGO
  receipt_photo_url       String?  @db.Text // Mantido apenas caso você queira permitir upload futuro
  created_at              DateTime @default(now()) @db.Timestamptz(3)
  
  // --- RELACIONAMENTOS ---
  area_id                 String   @db.Uuid
  area                    EcdWorkerArea @relation(fields: [area_id], references: [id])
  
  leader_id               String   @db.Uuid
  leader                  EcdWorkerLeader @relation(fields: [leader_id], references: [id])
  
  // 👇 Nulo na pré-inscrição, preenchido apenas quando você clicar em "Aprovar"
  edition_id              String?  @db.Uuid
  edition                 EcdEdition? @relation(fields: [edition_id], references: [id])
  
  token_id                String   @unique @db.Uuid
  token                   EcdWorkerToken @relation(fields: [token_id], references: [id])

  @@map("ecd_worker_registrations")
  @@schema("app")
}

model RepertoireSong {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title        String
  category     String    // Ex: "DOMINGO", "QUINTA-FEIRA"
  tone_fem     String?   // Tom Feminino (Opcional)
  tone_masc    String?   // Tom Masculino (Opcional)
  
  link_vs      String    // OBRIGATÓRIO (Drive/Multitrack)
  link_youtube String?   // (Opcional)
  link_spotify String?   // (Opcional)
  link_cifra   String?   // (Opcional)
  
  created_at   DateTime? @default(now()) @db.Timestamptz(3)

  @@map("repertoire_songs")
  @@schema("app")
}